# Copy to .env and fill in real values. .env is gitignored — never commit it.

# Used by db_analyst_agent.py (ChatAnthropic via langchain-anthropic)
ANTHROPIC_API_KEY=

# Optional: only if you switch db_analyst_agent.py to ChatGroq
GROQ_API_KEY=

# Paths (defaults are relative to the repo root)
CUSTOMER_DB_PATH=customer_data.db
SYSTEM_MEMORY_DB_PATH=system_memory.db
