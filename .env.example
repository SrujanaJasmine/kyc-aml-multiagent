# Copy to .env and fill in real values. .env is gitignored — never commit it.

# Used by db_analyst_agent.py (ChatGroq via langchain-groq).
# Free key from https://console.groq.com/keys
GROQ_API_KEY=

# Optional — overrides the default model in db_analyst_agent.py.
# Production models with tool calling: llama-3.3-70b-versatile (default),
# openai/gpt-oss-120b, openai/gpt-oss-20b, llama-3.1-8b-instant
GROQ_MODEL=llama-3.3-70b-versatile

# Paths (defaults are relative to the repo root)
CUSTOMER_DB_PATH=customer_data.db
SYSTEM_MEMORY_DB_PATH=system_memory.db
