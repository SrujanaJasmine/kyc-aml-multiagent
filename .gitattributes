# Normalize line endings so the repo is consistent across Windows/macOS/Linux
* text=auto eol=lf

*.py    text eol=lf
*.md    text eol=lf
*.txt   text eol=lf
*.json  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.bat   text eol=crlf
*.ps1   text eol=crlf

# Notebooks: treat as text but don't try to merge them
*.ipynb text eol=lf merge=binary linguist-documentation

# Binary — never diff or convert
*.joblib binary
*.pkl    binary
*.db     binary
*.png    binary
*.jpg    binary
*.pdf    binary
*.xlsx   binary
